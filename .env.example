# Application
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://cloudsec:change-me@localhost:5432/cloudsec

# PostgreSQL development container
POSTGRES_DB=cloudsec
POSTGRES_USER=cloudsec
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# API container
API_PORT=8000

# AWS inventory. Credentials come from the standard AWS credential chain.
AWS_REGION=us-east-1
AWS_PROFILE=
# Immutable policy identity. Change this numeric X.Y.Z version whenever policy content changes.
ASSESSMENT_PROFILE_VERSION=1.0.0
STALE_ACCESS_KEY_DAYS=90
REQUIRED_TAGS=Owner,Environment

# Authentication. Development mode uses the explicit non-secret bearer marker
# `local-development` and is allowed only with an explicit local/dev/test APP_ENV.
AUTH_MODE=development
DEV_IDENTITY_SUBJECT=local-developer
DEV_IDENTITY_ROLES=ADMIN

# Production OIDC/JWT verification (required when AUTH_MODE=oidc).
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHMS=RS256
OIDC_ROLES_CLAIM=roles
OIDC_ALLOW_INSECURE_HTTP=false
