# Application
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://cloudsec:change-me@localhost:5432/cloudsec

# PostgreSQL development container
POSTGRES_DB=cloudsec
POSTGRES_USER=cloudsec
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# API container
API_PORT=8000

# Reserved for later AWS inventory work; no AWS calls exist in Sprint 0.
AWS_REGION=us-east-1
AWS_PROFILE=
STALE_ACCESS_KEY_DAYS=90
REQUIRED_TAGS=Owner,Environment
