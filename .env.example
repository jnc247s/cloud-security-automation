# Application
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://cloudsec:change-me@localhost:5432/cloudsec

# PostgreSQL development container
POSTGRES_DB=cloudsec
POSTGRES_USER=cloudsec
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# API container
API_PORT=8000

# AWS inventory. Credentials come from the standard AWS credential chain.
AWS_REGION=us-east-1
AWS_PROFILE=
# Independent read-only verification opt-in; do not infer scope from AWS_REGION.
REMEDIATION_VERIFICATION_ENABLED=false
# When explicitly enabled, both must be set to the reviewed account/Region:
# REMEDIATION_VERIFICATION_ACCOUNT_ID=123456789012
# REMEDIATION_VERIFICATION_REGION=us-east-1
# Immutable policy identity. Change this numeric X.Y.Z version whenever policy content changes.
ASSESSMENT_PROFILE_VERSION=1.0.0
# Optional ASSESSMENT_PROFILE_FILE: protected local JSON outside Git; see docs/assessment-foundation.md.
# Unset means legacy environment-based policy. Do not set an empty path.
STALE_ACCESS_KEY_DAYS=90
REQUIRED_TAGS=Owner,Environment

# Authentication. Development mode uses the explicit non-secret bearer marker
# `local-development` and is allowed only with an explicit local/dev/test APP_ENV.
AUTH_MODE=development
DEV_IDENTITY_SUBJECT=local-developer
DEV_IDENTITY_ROLES=ADMIN

# Production OIDC/JWT verification (required when AUTH_MODE=oidc).
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHMS=RS256
OIDC_ROLES_CLAIM=roles
OIDC_ALLOW_INSECURE_HTTP=false

# Opt-in Sprint 7B shell. Disabled with the existing development defaults above.
# Enabling requires AUTH_MODE=oidc and the trusted provider configuration; see
# docs/operations/dashboard.md. Never paste a real client credential into this file.
DASHBOARD_ENABLED=false
# Independent Sprint 8D2 boundary; requires the enabled OIDC dashboard. Never enables a worker.
DASHBOARD_REMEDIATION_ENABLED=false
DASHBOARD_ORIGIN=
DASHBOARD_CLIENT_ID=
DASHBOARD_CLIENT_SECRET=
DASHBOARD_SCOPES=openid
